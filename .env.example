# =============================================================================
# Service Booking — Environment variables
# =============================================================================
# Local:  copy to `.env.local` (gitignored)
# Prod:   set in Hostinger → Websites → Manage → Environment variables
# =============================================================================

# Google Search Console verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Form email (SMTP) ---
# Use the SMTP server for wherever support@servicebooking.in is hosted.
#
# Hostinger email (if mailbox is on Hostinger):
#   SMTP_HOST=smtp.hostinger.com
#   SMTP_PORT=465
#
# Zoho Mail (if mailbox is on Zoho):
#   SMTP_HOST=smtp.zoho.in
#   SMTP_PORT=465
#
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
# Use ONE of these (B64 is safer if password contains # or |):
SMTP_PASS=
# echo -n 'your-password' | base64
SMTP_PASS_B64=

# Recommended (avoids angle-bracket issues in Hostinger env panel):
SMTP_FROM_NAME=Service Booking
SMTP_FROM_EMAIL=support@servicebooking.in

# Comma- or semicolon-separated for multiple recipients
LEAD_NOTIFICATION_EMAIL=support@servicebooking.in

# --- Live blogs from AI Growth Platform (no redeploy on publish) ---
# Platform URL (local: http://localhost:3000 — production: your platform host)
PLATFORM_BLOG_API_URL=
# Business slug from platform (e.g. demo-plumbing-co)
PLATFORM_BUSINESS_SLUG=
# Optional — only if platform has BLOG_PUBLIC_API_KEY set
PLATFORM_BLOG_API_KEY=
