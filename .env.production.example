# =============================================================================
# Service Booking — Production environment variables (Hostinger)
# =============================================================================
# Copy these into Hostinger → Websites → Manage → Environment variables
# Do NOT upload this file with real passwords to git.
# =============================================================================

NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-gsc-token
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=support@servicebooking.in

# IMPORTANT: passwords with # or | break plain SMTP_PASS on many hosts.
# Use base64 instead (no quotes needed in Hostinger panel):
#   echo -n 'your-password' | base64
SMTP_PASS_B64=MXRZI3xwR1M=

SMTP_FROM_NAME=Service Booking
SMTP_FROM_EMAIL=support@servicebooking.in
LEAD_NOTIFICATION_EMAIL=srini.spatil@gmail.com,another@example.com

# Live blog CMS — published posts appear without redeploying the site
# (platform must be publicly reachable from Hostinger)
PLATFORM_BLOG_API_URL=https://your-platform-host.example.com
PLATFORM_BUSINESS_SLUG=demo-plumbing-co
# Optional shared secret (must match platform BLOG_PUBLIC_API_KEY)
PLATFORM_BLOG_API_KEY=

# =============================================================================
# Hostinger notes
# =============================================================================
# - Do not wrap values in quotes in the Hostinger panel (quotes become part of value)
# - Prefer SMTP_PASS_B64 over SMTP_PASS when password has # | @ etc.
# - Redeploy / restart Node app after saving env vars
# - Site must run as Node.js (not static export) for /api/leads to work
# - After setting PLATFORM_* once, new blog publishes go live via API (~60s)
# =============================================================================
